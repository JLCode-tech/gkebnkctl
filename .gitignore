# Local config (copy cluster.yaml.example -> cluster.yaml and edit)
cluster.yaml
# Exception: the committed working examples.
!examples/*/cluster.yaml

# Post-provision discovery output for the bash seed (regenerate with
# bash-seed/bin/25-discover.sh). The Go binary's equivalent
# (Phase25Discover) caches into .gkebnkctl/<cluster>/state.env instead — see
# that entry below.
discovered.env

# Rendered manifests for the bash seed (regenerated by envsubst from
# bash-seed/manifests/*.tmpl each run). The Go binary never
# writes rendered manifests to disk.
.rendered/

# Secret material — never commit
*.jwt
license.jwt
/kubeconfig
*.kubeconfig
dockerconfig.json
.dockerconfigjson
forge_agent_token.json
*.forge_agent_token.*.json.tmp
# Exception: an obvious, committed placeholder so `gkebnkctl validate` /
# `up --dry-run` have something to point bnk.jwtPath at without a real
# secret. Never put real subscription JWT content here.
!examples/*/license.jwt

# Go build artifacts
/gkebnkctl
/bin/
/dist/
/artifacts/
*.exe
*.test
*.out
node_modules/

# Local environment files
.env
.env.*

# Go-SDK state dirs (`.gkebnkctl/<cluster>/state.env` IDs cache — see
# internal/gcp/state)
.gkebnkctl/

# OS / editor cruft / PR temp files
.DS_Store
*.swp
.*-pr-body.md
/workspaces/

# --- Internal dev tooling & working docs (not for public repo) ---
# AI-assisted dev framework (MAF / OpenCode / Claude Code); lives on local disk only.
.agent/
.agent-local/
.claude/
.opencode/
opencode.json
opencode.jsonc
CLAUDE.md
CLAUDE.local.md
ACTIVE_CONTEXT.md
docs/audits/
docs/design/
docs/spikes/
docs/demo/
docs/adr/
docs/REMEDIATION.md

# --- MAF framework operational artifacts (installer-managed) ---
*.maf.new
