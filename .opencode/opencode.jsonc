{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://f5ai.pd.f5net.com/openai",
        "apiKey": "{env:F5AI_API_KEY}"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude 4.8 Opus",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://f5ai.pd.f5net.com/openai",
        "apiKey": "{env:F5AI_API_KEY}"
      }
    }
  }
}
