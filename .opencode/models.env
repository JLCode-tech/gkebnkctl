# OpenCode Tier Mappings (Legacy / Fallback)
#
# Primary role-to-model and executor routing is configured in .agent/model-routing.yaml (ADR-037).
# This file provides tier-level fallback defaults for OpenCode sessions.
#
# Format: TIER_MODEL=provider/model-id
# The provider prefix (e.g., "anthropic/") must match a provider in opencode.json

# --- Tier Assignments ---
FRONTIER_MODEL=f5ai/claude-opus-4-7
WORKHORSE_MODEL=f5ai/claude-sonnet-4-6
FAST_MODEL=f5ai/claude-haiku-4-5

# --- Utility Models ---
# NOTE (2026-06-12): COMPACTION_MODEL is INERT under OpenCode. OpenCode's compaction is a built-in
# hidden `compaction` agent configured via opencode.json (agent.compaction.model), NOT via this var
# nor `small_model` (which is title-generation only). Leaving this unset means compaction runs on the
# default model (opus-4-7). To use a cheaper compaction model, add an `agent.compaction` block to the
# GLOBAL ~/.config/opencode/opencode.json. Value below is retained only for Claude Code / other harness
# compatibility; it does nothing in OpenCode.
COMPACTION_MODEL=f5ai/claude-haiku-4-5

# --- Per-Role Overrides (optional) ---
# Uncomment to assign a specific model to a role, overriding its tier.
# Example: use a different Anthropic model for one role.
#LEAD_MODEL=anthropic/claude-opus-4-7
#LEAD_OPS_MODEL=anthropic/claude-opus-4-7
#ARCHITECT_MODEL=anthropic/claude-opus-4-7
#REVIEWER_MODEL=anthropic/claude-sonnet-4-6

# Builder + auditor run on OpenAI GPT via the LLM_API_KEY gateway (openai provider).
# NOTE: these only take effect under OpenCode. Claude Code's Agent tool is
# Anthropic-only and cannot spawn a GPT-backed subagent.
# builder-upgraded auto-syncs to WORKHORSE_MODEL (sonnet) via `apply`.
# builder-lite is not in the apply role loop — its agent file is set manually.
BUILDER_MODEL=f5ai/gpt-5.3-codex
AUDITOR_MODEL=f5ai/gpt-5.5
