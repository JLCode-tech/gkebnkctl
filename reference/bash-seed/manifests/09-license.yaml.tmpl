# PROVEN LIVE 2026-07-20 on bnk-hostdev — this exact shape reached
# License status Active/eval in ~60s. Without it: "Configs are not allowed
# since license is not activated" and no VLAN programming (contract item 6
# in reference/TRIAL-NOTES.md).
#
# Rendered by bin/30-bnk-install.sh from the JWT file at cluster.yaml's
# bnk.jwtPath — `jwt` is the RAW token string (whitespace-trimmed file
# contents, NOT base64). The JWT content is read at apply time and is
# never written to a file in this repo.
apiVersion: k8s.f5net.com/v1
kind: License
metadata:
  name: bnk-license
  namespace: f5-utils
spec:
  operationMode: connected
  jwt: ${LICENSE_JWT}
  teemCertUrl: https://product.apis.f5.com/ee/v1
  teemEntitlementUrl: https://product-s.apis.f5.com/ee/v1
  teemInitialConfigUrl: https://product-s.apis.f5.com/ee/v1
