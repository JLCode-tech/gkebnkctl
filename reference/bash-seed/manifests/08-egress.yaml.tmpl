# Rendered by bin/40-egress.sh (envsubst) from cluster.yaml + discovered.env.
apiVersion: k8s.f5net.com/v3
kind: F5SPKEgress
metadata:
  name: egress-agents
  namespace: f5-bnk
spec:
  egressSnatpoolMode: UNIQUE_SNAT_ADDRESS
  maxTmmReplicas: 1
  snatType: SRC_TRANS_AUTOMAP
  pseudoCNIConfig:
    appPodInterface: eth0
    namespaces:
    - ${CFG_EGRESS_TESTNAMESPACE}
    vxlan:
      create: true
      key: ${CFG_EGRESS_VXLANKEY}
      mtu: ${CFG_EGRESS_VXLANMTU}
      nodeInterfaceName: ${AGENT_EXT_IFACE}
      port: ${CFG_EGRESS_VXLANPORT}
      tmmInterfaceName: external
      vrf: ""
---
apiVersion: v1
kind: Pod
metadata:
  name: egress-client
  namespace: ${CFG_EGRESS_TESTNAMESPACE}
spec:
  nodeSelector:
    cloud.google.com/gke-nodepool: ${CFG_CLUSTER_AGENTPOOL_NAME}
  containers:
  - name: netshoot
    image: nicolaka/netshoot
    command: ["sleep", "infinity"]
