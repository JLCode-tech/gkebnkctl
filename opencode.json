{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 25000
  },
  "agent": {
    "compaction": {
      "model": "anthropic/claude-haiku-4-5"
    },
    "lead": {
      "mode": "primary"
    },
    "lead-ops": {
      "mode": "subagent"
    },
    "architect": {
      "mode": "subagent"
    },
    "builder": {
      "mode": "subagent"
    },
    "builder-lite": {
      "mode": "subagent"
    },
    "builder-upgraded": {
      "mode": "subagent"
    },
    "reviewer": {
      "mode": "subagent"
    },
    "auditor": {
      "mode": "subagent"
    }
  },
  "instructions": [
    ".agent/AGENTS.md",
    ".agent/ACTIVE_CONTEXT.md",
    ".agent/context/opencode-maf-runtime.md"
  ],
  "default_agent": "lead",
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "claude-opus-4-7": {
          "name": "Claude 4.7 Opus",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-opus-4-6": {
          "name": "Claude 4.6 Opus",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude 4.6 Sonnet",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-sonnet-4-5": {
          "name": "Claude 4.5 Sonnet",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-haiku-4-5": {
          "name": "Claude 4.5 Haiku",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        }
      }
    }
  },
  "enabled_providers": [
    "anthropic",
    "openai"
  ],
  "share": "disabled",
  "model": "anthropic/claude-opus-4-7",
  "small_model": "openai/gpt-5.3-codex",
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "rm -rf *": "deny"
    },
    "edit": "allow",
    "webfetch": "ask",
    "websearch": "ask"
  }
}
